#!/usr/bin/env bash
# og-release -- bump the plugin version, and catch the drift that makes updates silently no-op.
#
#   og-release check              report whether the version is stale vs the last release tag
#   og-release bump <level>       bump .claude-plugin/plugin.json (major|minor|patch|X.Y.Z)
#
# WHY THIS EXISTS
#   `claude plugin update` keys off the VERSION STRING in .claude-plugin/plugin.json, not the
#   commit. If a release lands without bumping it, `update` reports "already at the latest
#   version" and pulls NOTHING. The changes are merged, tagged or not, and undeliverable.
#   That happened: v0.1.5 shipped, then a new universal rule and a new tool merged on top of
#   it, and every user's `claude plugin update` said "up to date" while fetching neither.
#
# Release flow (the version bump must go through a PR; main is protected):
#   1. og-release bump minor      # edits .claude-plugin/plugin.json
#   2. commit, PR, merge
#   3. claude plugin tag --push   # tags main as og--v<version>, validating plugin.json agrees
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
PJ="$ROOT/.claude-plugin/plugin.json"
[ -f "$PJ" ] || { echo "error: no $PJ" >&2; exit 1; }
command -v jq >/dev/null || { echo "error: jq required" >&2; exit 1; }

cur=$(jq -r .version "$PJ")
name=$(jq -r .name "$PJ")

# Release tags. The canonical format is `<name>--v<version>` (what `claude plugin tag`
# creates). Older repos may carry legacy `v<version>` tags -- honor those too, or `check`
# reports "no release tag exists yet" in a repo that plainly has one, and the STALE
# comparison silently never fires.
# Sets the globals LT (version) and TAG_FMT (prefix). Deliberately does NOT print-and-capture:
# `lt=$(last_tag)` would run it in a SUBSHELL, so any global it set would be discarded and the
# caller would silently see an empty prefix.
LT=""; TAG_FMT=""
find_last_tag() {
  LT=$(git -C "$ROOT" tag --list "${name}--v*" | sed "s/^${name}--v//" | sort -V | tail -1)
  if [ -n "$LT" ]; then TAG_FMT="${name}--v"; return 0; fi
  LT=$(git -C "$ROOT" tag --list 'v[0-9]*' | sed 's/^v//' | sort -V | tail -1)
  if [ -n "$LT" ]; then TAG_FMT="v"; return 0; fi
  return 1
}

cmd_check() {
  find_last_tag || true
  local lt="$LT"
  echo ".claude-plugin/plugin.json: v$cur"
  if [ -z "$lt" ]; then
    echo "no release tag found (looked for ${name}--v* and legacy v*)"
  else
    echo "last tag:    ${TAG_FMT}${lt}$([ "$TAG_FMT" = "v" ] && echo '  (legacy format; new tags will be '"${name}"'--v<version>)')"
  fi
  local since
  if [ -n "$lt" ] && git -C "$ROOT" rev-parse -q --verify "${TAG_FMT}${lt}" >/dev/null; then
    since=$(git -C "$ROOT" rev-list --count "${TAG_FMT}${lt}..HEAD")
  else
    since=$(git -C "$ROOT" rev-list --count HEAD)
  fi
  echo "commits since that tag: $since"
  if [ "$since" -gt 0 ] && [ "$cur" = "${lt:-}" ]; then
    echo
    echo "STALE: there are $since commit(s) since v$cur, but the version was not bumped."
    echo "       \`claude plugin update\` compares the VERSION STRING -- it will report"
    echo "       \"already at the latest version\" and pull none of them."
    echo "       Run: og-release bump <major|minor|patch>"
    return 1
  fi
  echo "OK"
}

cmd_bump() {
  local level="${1:?usage: og-release bump <major|minor|patch|X.Y.Z>}" new
  case "$level" in
    major|minor|patch)
      IFS=. read -r a b c <<<"$cur"
      case "$level" in
        major) new="$((a+1)).0.0" ;;
        minor) new="${a}.$((b+1)).0" ;;
        patch) new="${a}.${b}.$((c+1))" ;;
      esac ;;
    [0-9]*.[0-9]*.[0-9]*) new="$level" ;;
    *) echo "error: level must be major|minor|patch or X.Y.Z" >&2; exit 1 ;;
  esac
  jq --arg v "$new" '.version = $v' "$PJ" > "$PJ.tmp" && mv "$PJ.tmp" "$PJ"
  echo "$name: $cur -> $new"
  echo "Next: commit + PR + merge, then \`claude plugin tag --push\` on main."
}

case "${1:-check}" in
  check) cmd_check ;;
  bump)  shift; cmd_bump "$@" ;;
  *) echo "usage: og-release [check|bump <level>]" >&2; exit 1 ;;
esac
