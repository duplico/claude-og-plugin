#!/usr/bin/env bash
# og-copilot-review: Request (or re-request) a GitHub Copilot code review on a PR
#
# Copilot does NOT auto-review on push. After a PR is updated with fix commits,
# Copilot will not re-review unless the review is explicitly re-requested each
# round. A "wait for Copilot" flow must therefore REQUEST first, then poll
# (see og-copilot-comments) -- polling alone hangs forever after round one.
#
# Uses the REST requested_reviewers endpoint with the bot login, then VERIFIES
# the request actually took from the response body. We deliberately do NOT use
# `gh pr edit --add-reviewer @copilot`: that alias needs gh >= 2.88.0 and, on
# older gh, silently no-ops while still exiting 0 -- a false-positive success.
# The REST path is version-independent and echoes back the requested reviewers.
#
# Note on re-requests: requesting again on an UNCHANGED head is deduped by GitHub
# ("already up to date") -- a fresh review only lands after a new head commit is
# pushed and the review is re-requested. If Copilot's prior review is stale and
# blocking a re-review, minimize (mark outdated) its previous review in the UI or
# via GraphQL first; this script intentionally stays on the plain request path.
#
# Usage: og-copilot-review owner/repo PR_NUMBER
#
# Output: JSON { repo, pr, requested, method, head_sha, note }
#   requested is true only when a Copilot login is confirmed in the response's
#   requested_reviewers -- never inferred from an exit code alone.
#
# Example:
#   og-copilot-review 1512-ninja/ha-1512 44

set -euo pipefail

usage() {
    echo "Usage: $0 owner/repo PR_NUMBER" >&2
    exit 1
}

if [[ $# -ne 2 ]]; then
    usage
fi

REPO="$1"
PR_NUMBER="$2"

# Validate repo format
if [[ ! "$REPO" =~ ^[^/]+/[^/]+$ ]]; then
    echo "Error: Repository must be in 'owner/repo' format" >&2
    exit 1
fi

# Validate PR number
if ! [[ "$PR_NUMBER" =~ ^[0-9]+$ ]]; then
    echo "Error: PR number must be a positive integer" >&2
    exit 1
fi

HEAD_SHA=$(gh api "repos/${REPO}/pulls/${PR_NUMBER}" --jq '.head.sha')

# Request via REST. The response is the PR object, including requested_reviewers.
RESP=$(gh api -X POST "repos/${REPO}/pulls/${PR_NUMBER}/requested_reviewers" \
    -f 'reviewers[]=copilot-pull-request-reviewer[bot]' 2>/dev/null) || RESP=""

# Confirm a Copilot login is actually present in the echoed requested_reviewers.
CONFIRMED="false"
if [[ -n "$RESP" ]]; then
    CONFIRMED=$(echo "$RESP" | jq -r '
        [(.requested_reviewers // [])[].login | ascii_downcase | contains("copilot")]
        | any' 2>/dev/null || echo "false")
fi

# Fallback verification: a fresh request may have been deduped (already pending),
# so the POST response might not echo it. Re-check the PR's current reviewers.
if [[ "$CONFIRMED" != "true" ]]; then
    CONFIRMED=$(gh api "repos/${REPO}/pulls/${PR_NUMBER}" --jq '
        [(.requested_reviewers // [])[].login | ascii_downcase | contains("copilot")]
        | any' 2>/dev/null || echo "false")
fi

if [[ "$CONFIRMED" != "true" ]]; then
    echo "Error: Copilot review request did not take." >&2
    echo "  The requested_reviewers list shows no Copilot login after the request." >&2
    echo "  Check: repo has Copilot code review enabled, and you have access to request it." >&2
    exit 1
fi

NOTE="Requested and confirmed in requested_reviewers. Copilot does not auto-review on push; re-request each round. Poll with og-copilot-comments --since-head."

jq -n \
    --arg repo "$REPO" \
    --argjson pr "$PR_NUMBER" \
    --arg method "rest-api" \
    --arg head_sha "$HEAD_SHA" \
    --arg note "$NOTE" \
    '{
        repo: $repo,
        pr: $pr,
        requested: true,
        method: $method,
        head_sha: $head_sha,
        note: $note
    }'
