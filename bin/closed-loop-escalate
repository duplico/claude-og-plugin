#!/usr/bin/env bash
# closed-loop-escalate: Post AWAITING_HUMAN escalation comment
#
# Posts a structured escalation comment that:
# - Includes <!-- AWAITING_HUMAN: reason --> marker
# - Includes AI session marker for filtering
# - Tags the maintainer (default: repo owner; override with --notify or OG_ESCALATE_NOTIFY)
# - Includes proper AI disclosure
#
# Usage: closed-loop-escalate owner/repo PR_NUMBER REASON "message" [options]
#
# REASON must be one of:
#   not_converging    - Issues not decreasing round-over-round
#   circular_feedback - Same issue appears repeatedly or A->B->A
#   design_decision   - Category C items requiring human decision
#   round_limit       - Configured round limit reached
#   ci_timeout        - CI did not complete within the timeout (stuck, or never ran)
#   awaiting_review   - No reviews arrived in the window (NOT a failure; waiting on a human)
#
# Options:
#   --session UUID    Session UUID for marker (required if continuing session)
#   --model MODEL     Model name for disclosure (default: "Opus 4.7")
#   --round N         Current round number for context
#   --history JSON    Round history as JSON array for summary table
#   --notify HANDLE   GitHub handle to notify (with or without leading @).
#                      Falls back to $OG_ESCALATE_NOTIFY, then the repo owner.
#
# Example:
#   closed-loop-escalate SouthwestCCDC/magpie 42 design_decision "Architecture change needed" \
#     --session abc-123 --round 2

set -euo pipefail

usage() {
    cat << 'EOF'
Usage: closed-loop-escalate owner/repo PR_NUMBER REASON "message" [options]

REASON must be one of:
  not_converging    - Issues not decreasing round-over-round
  circular_feedback - Same issue appears repeatedly or A->B->A
  design_decision   - Category C items requiring human decision
  round_limit       - Configured round limit reached
  ci_timeout        - CI did not complete within the timeout (stuck, or never ran)
  awaiting_review   - No reviews arrived in the window (NOT a failure; waiting on a human)

Options:
  --session UUID    Session UUID for marker
  --model MODEL     Model name for disclosure (default: "Opus 4.7")
  --round N         Current round number
  --history JSON    Round history as JSON array
  --notify HANDLE   GitHub handle to notify (with or without leading @).
                     Tags the maintainer (default: repo owner; override with
                     --notify or OG_ESCALATE_NOTIFY)

Example:
  closed-loop-escalate SouthwestCCDC/magpie 42 design_decision "Need decision on API design"
EOF
    exit 1
}

# Parse arguments
if [[ $# -lt 4 ]]; then
    usage
fi

REPO="$1"
PR_NUMBER="$2"
REASON="$3"
MESSAGE="$4"
shift 4

# Defaults
SESSION_UUID=""
MODEL="Opus 4.7"
ROUND=""
HISTORY=""
NOTIFY_HANDLE=""

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        --session)
            SESSION_UUID="$2"
            shift 2
            ;;
        --model)
            MODEL="$2"
            shift 2
            ;;
        --round)
            ROUND="$2"
            shift 2
            ;;
        --history)
            HISTORY="$2"
            shift 2
            ;;
        --notify)
            NOTIFY_HANDLE="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            ;;
    esac
done

# Validate repo format
if [[ ! "$REPO" =~ ^[^/]+/[^/]+$ ]]; then
    echo "Error: Repository must be in 'owner/repo' format" >&2
    exit 1
fi

# Validate PR number
if ! [[ "$PR_NUMBER" =~ ^[0-9]+$ ]]; then
    echo "Error: PR number must be a positive integer" >&2
    exit 1
fi

# Validate reason
case "$REASON" in
    not_converging|circular_feedback|design_decision|round_limit|ci_timeout|awaiting_review)
        ;;
    *)
        echo "Error: Invalid reason '$REASON'" >&2
        echo "Must be one of: not_converging, circular_feedback, design_decision, round_limit, ci_timeout, awaiting_review" >&2
        exit 1
        ;;
esac

# Resolve the handle to notify, in order of precedence:
#   1. --notify HANDLE
#   2. $OG_ESCALATE_NOTIFY
#   3. Auto-derived repo owner (via `gh repo view`)
#   4. Unresolved -- fall back to a neutral, handle-free message
if [[ -z "$NOTIFY_HANDLE" ]]; then
    NOTIFY_HANDLE="${OG_ESCALATE_NOTIFY:-}"
fi
if [[ -z "$NOTIFY_HANDLE" ]]; then
    NOTIFY_HANDLE=$(gh repo view "$REPO" --json owner --jq '.owner.login' 2>/dev/null || true)
    if [[ -n "$NOTIFY_HANDLE" ]]; then
        NOTIFY_HANDLE="@${NOTIFY_HANDLE}"
    fi
fi
# Normalize to a single leading @ (handles values supplied with or without one)
if [[ -n "$NOTIFY_HANDLE" ]]; then
    NOTIFY_HANDLE="@${NOTIFY_HANDLE#@}"
fi

# Generate session UUID if not provided
if [[ -z "$SESSION_UUID" ]]; then
    SESSION_UUID=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)
fi

# Map reason to human-readable description
case "$REASON" in
    not_converging)
        REASON_DESC="Issues are not decreasing round-over-round"
        ;;
    circular_feedback)
        REASON_DESC="Circular feedback detected (same issues recurring or reverting changes)"
        ;;
    design_decision)
        REASON_DESC="Design decision required (Category C items present)"
        ;;
    round_limit)
        REASON_DESC="Round limit reached"
        ;;
    ci_timeout)
        REASON_DESC="CI did not complete within the configured timeout (it may be stuck, or no CI ran)"
        ;;
    awaiting_review)
        REASON_DESC="No reviews arrived within the configured window. This is not a failure -- the PR is simply waiting on a human reviewer."
        ;;
esac

# Build history table if provided
HISTORY_TABLE=""
if [[ -n "$HISTORY" ]]; then
    HISTORY_TABLE="
**Review history**:
| Round | Comments | Addressed | Remaining |
|-------|----------|-----------|-----------|"

    # Parse JSON history and build table rows
    while IFS= read -r row; do
        HISTORY_TABLE="${HISTORY_TABLE}
${row}"
    done < <(echo "$HISTORY" | jq -r '.[] | "| \(.round) | \(.comments) | \(.addressed) | \(.remaining) |"')
fi

# Build round info if provided
ROUND_INFO=""
if [[ -n "$ROUND" ]]; then
    ROUND_INFO="**Current round**: ${ROUND}

"
fi

# Build the notify line: tag the resolved handle, or fall back to a neutral
# message if no handle could be resolved (never emit a broken bare "@").
if [[ -n "$NOTIFY_HANDLE" ]]; then
    NOTIFY_LINE="${NOTIFY_HANDLE} - Please respond when ready to continue."
else
    NOTIFY_LINE="A human maintainer's input is required -- please respond when ready to continue."
fi

# Construct escalation comment
FULL_COMMENT="<!-- AI:closed-loop:${SESSION_UUID} -->
<!-- AWAITING_HUMAN: ${REASON} -->

## Agent Paused - Human Input Required

**Reason**: ${REASON_DESC}

${ROUND_INFO}${MESSAGE}
${HISTORY_TABLE}

${NOTIFY_LINE}

(AI-generated via Claude Code w/ ${MODEL})"

# Post comment
gh pr comment "${PR_NUMBER}" --repo "${REPO}" --body "${FULL_COMMENT}"

# Output confirmation
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
cat << EOF
{
  "posted": true,
  "repo": "${REPO}",
  "pr": ${PR_NUMBER},
  "reason": "${REASON}",
  "session_uuid": "${SESSION_UUID}",
  "escalated_at": "${TIMESTAMP}"
}
EOF
